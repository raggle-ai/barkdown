{
	"name": "@raggle-ai/barkdown",
	"version": "0.1.1",
	"description": "Core BarkDown renderer for Markdown and trusted MDX strings.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/raggle-ai/barkdown.git",
		"directory": "packages/barkdown"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./styles.css": "./styles.css"
	},
	"files": [
		"dist",
		"README.md",
		"styles.css"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"dependencies": {
		"@mdx-js/mdx": "^3.1.1",
		"lucide-react": "^1.21.0",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1"
	},
	"peerDependencies": {
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@types/react": "^19.2.2",
		"typescript": "^5.9.3"
	}
}
