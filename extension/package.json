    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.2",
    "@types/node": "^22.13.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
